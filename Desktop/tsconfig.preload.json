{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist/preload",
    "rootDir": "app/preload",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["app/preload/**/*"],
  "exclude": ["node_modules"]
}
