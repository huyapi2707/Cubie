{
  "name": "voice-worker",
  "version": "1.0.0",
  "description": "Production-ready Multi-User WebSocket Server for real-time audio streaming and processing",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": ["websocket", "audio", "streaming", "real-time", "voice"],
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.2.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.2",
    "ws": "^8.18.1",
    "zod": "^3.24.2",
    "ioredis": "^5.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "rimraf": "^6.0.1",
    "eslint": "^9.22.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
